<Window x:Class="DEPO_DURUMU.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Depo Durumu"
        Height="600" Width="1000"
        MinHeight="500" MinWidth="800"
        WindowStartupLocation="CenterScreen">

    <DockPanel>

        <!-- ÜST MENÜ (her pencerede görünecek) -->
        <Menu DockPanel.Dock="Top" Padding="4">
            <MenuItem Header="🏠"
                      FontSize="15"
                      ToolTip="Ana Sayfa"
                      Click="HomeMenu_Click" />
            <MenuItem Header="Ayarlar">
                <MenuItem Header="Ürün Grupları" Click="TypesMenu_Click" />
                <MenuItem Header="Ürün Bilgileri" Click="PropertiesMenu_Click" />
                <MenuItem Header="Log" Click="LogMenu_Click" />
                <MenuItem Header="Dışa Aktar (Excel)">
                    <MenuItem Header="Depo + Hurda (Excel, tek dosya, iki sayfa)..." Click="ExportBothExcelMenu_Click" />
                    <MenuItem Header="Sadece Depo (Excel)..." Click="ExportDepotExcelMenu_Click" />
                    <MenuItem Header="Sadece Hurda (Excel)..." Click="ExportScrapExcelMenu_Click" />
                    <Separator />
                    <MenuItem Header="Tüm Grupları (CSV)..." Click="ExportAllTypesMenu_Click" />
                </MenuItem>
                <MenuItem Header="İçe Aktar (Excel)">
                    <MenuItem Header="Depoya (Excel/CSV)..." Click="ImportAllTypesMenu_Click" />
                    <MenuItem Header="Hurdaya (Excel/CSV)..." Click="ImportScrapMenu_Click" />
                </MenuItem>
                <MenuItem Header="Yedekleme">
                    <MenuItem Header="Yedek Al..." Click="BackupButton_Click" />
                    <MenuItem Header="Yedekten Geri Yükle..." Click="RestoreButton_Click" />
                </MenuItem>
                <Separator />
                <MenuItem Header="Tüm Verileri Sıfırla..." Foreground="#B00020" Click="ResetMenu_Click" />
            </MenuItem>
            <MenuItem Header="Hurda" Click="ScrapMenu_Click" />
            <MenuItem Header="Zimmetler" Click="AssignmentsMenu_Click" />
            <MenuItem Header="Tutanaklar" Click="HandoversMenu_Click" />
        </Menu>

        <!-- MENÜNÜN ALTINDAKİ ALAN: iki sayfa üst üste durur, biri görünür -->
        <Grid>

            <!-- SAYFA 1: ANA SAYFA -->
            <Grid x:Name="HomePage">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- SOL BÖLÜM: ürün cinsleri -->
                <DockPanel Grid.Column="0" Margin="10">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBox x:Name="HomeSearchBox"
                                 Height="26"
                                 VerticalContentAlignment="Center"
                                 TextChanged="HomeSearchBox_TextChanged"
                                 KeyDown="HomeSearchBox_KeyDown" />
                        <TextBlock x:Name="HomeSearchPlaceholder"
                                   Text="Ara"
                                   Foreground="Gray"
                                   Margin="6,0,0,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False" />
                    </Grid>

                    <TextBlock DockPanel.Dock="Top"
                               Text="Ürün grupları "
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Margin="0,0,0,5" />

                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBox x:Name="TypeFilterBox"
                                 Height="26"
                                 VerticalContentAlignment="Center"
                                 TextChanged="TypeFilterBox_TextChanged" />
                        <TextBlock x:Name="TypeFilterPlaceholder"
                                   Text="Grupta ara"
                                   Foreground="Gray"
                                   Margin="6,0,0,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False" />
                    </Grid>

                    <ListBox x:Name="ProductTypeList"
                             MouseDoubleClick="ProductTypeList_MouseDoubleClick" />
                </DockPanel>

                <!-- ORTA BÖLÜM: istatistik kutuları + son işlemler -->
                <DockPanel Grid.Column="1" Margin="0,10,10,10">
                    <WrapPanel x:Name="StatisticsPanel" DockPanel.Dock="Top" />

                    <TextBlock DockPanel.Dock="Top"
                               Text="Son işlem yapılan cihazlar"
                               FontWeight="SemiBold"
                               Margin="0,15,0,5" />

                    <TextBlock x:Name="NoRecentLogText"
                               DockPanel.Dock="Top"
                               Text="Henüz işlem yapılmış cihaz yok."
                               Foreground="Gray"
                               Visibility="Collapsed" />

                    <DataGrid x:Name="RecentLogGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserSortColumns="False"
                              HeadersVisibility="Column"
                              MaxHeight="260">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Zaman" Binding="{Binding CreatedAt, StringFormat='dd.MM.yyyy HH:mm'}" Width="130" />
                            <DataGridTextColumn Header="Ürün tipi" Binding="{Binding TypeName}" Width="120" />
                            <DataGridTextColumn Header="Ürün" Binding="{Binding Description}" Width="*" />
                            <DataGridTextColumn Header="Son işlem" Binding="{Binding ActionType}" Width="140" />
                            <DataGridTextColumn Header="Kullanıcı" Binding="{Binding UserName}" Width="100" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Grid>

            <!-- SAYFA 2: ÜRÜN CİNSİ SAYFASI -->
            <Grid x:Name="TypePage" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- SOL BÖLÜM: iki mod var, biri görünür -->
                <Grid Grid.Column="0">

                    <!-- MOD 1: NORMAL BAR (geri, özellik ata, ürün ekle, filtrele düğmeleri) -->
                    <StackPanel x:Name="NormalLeftPanel" Margin="10">

                        <Button Content="&#x2190; Ana sayfaya dön"
                                Click="BackButton_Click"
                                Height="30"
                                Margin="0,0,0,10" />

                        <Button Content="Ürün bilgilerini düzenle"
                                Click="AssignPropertiesButton_Click"
                                Height="30"
                                Margin="0,0,0,10" />

                        <Button Content="Yeni Ürün Ekle"
                                Click="AddProductButton_Click"
                                Height="30"
                                Margin="0,0,0,10" />

                        <Button x:Name="FilterButton"
                                Content="Filtrele"
                                Click="FilterButton_Click"
                                Height="30"
                                Margin="0,0,0,10" />

                        <Button Content="Grubu Dışa Aktar (Excel/CSV)"
                                Click="ExportCsvButton_Click"
                                Height="30"
                                Margin="0,0,0,10" />

                        <Button Content="Gruba İçe Aktar (CSV)"
                                Click="ImportCsvButton_Click"
                                Height="30"
                                Margin="0,0,0,10" />

                    </StackPanel>

                    <!-- MOD 2: FİLTRE BARI (üstte geri, altında filtre öğeleri) -->
                    <DockPanel x:Name="FilterLeftPanel"
                               Margin="10"
                               Visibility="Collapsed">

                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">

                            <Button Content="&#x2190; Geri"
                                    Height="30"
                                    HorizontalAlignment="Left"
                                    Width="80"
                                    Margin="0,0,0,10"
                                    Click="FilterBackButton_Click" />

                            <DockPanel>
                                <Button DockPanel.Dock="Right"
                                        Content="Temizle"
                                        Width="70"
                                        Click="ClearFiltersButton_Click" />
                                <TextBlock Text="Filtreler"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                            </DockPanel>

                        </StackPanel>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="FilterItemsPanel" />
                        </ScrollViewer>

                    </DockPanel>

                </Grid>

                <!-- ORTA BÖLÜM: Excel benzeri tablo -->
                <DockPanel Grid.Column="1" Margin="0,10,10,10">

                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock x:Name="ProductCountText"
                                   DockPanel.Dock="Right"
                                   Foreground="Gray"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="TypePageTitle"
                                   FontWeight="Bold"
                                   FontSize="16" />
                    </DockPanel>

                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBox x:Name="TypeSearchBox"
                                 Height="26"
                                 VerticalContentAlignment="Center"
                                 TextChanged="TypeSearchBox_TextChanged"
                                 KeyDown="HomeSearchBox_KeyDown" />
                        <TextBlock x:Name="TypeSearchPlaceholder"
                                   Text="Tüm uygulamada ara"
                                   Foreground="Gray"
                                   Margin="6,0,0,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False" />
                    </Grid>

                    <StackPanel DockPanel.Dock="Top"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,0,0,10">
                        <Button Content="Tümünü Seç/Kaldır"
                                Width="140"
                                Height="30"
                                Margin="0,0,6,0"
                                Click="SelectAllButton_Click" />
                        <Button Content="Hurdaya Taşı"
                                Width="120"
                                Height="30"
                                Margin="0,0,6,0"
                                Click="MoveSelectedToScrapButton_Click" />
                        <Button Content="Seçilenleri Sil"
                                Width="130"
                                Height="30"
                                Click="DeleteSelectedButton_Click" />
                    </StackPanel>

                    <TextBlock DockPanel.Dock="Bottom"
                               Text="Bir ürünün detayını görmek/düzenlemek/silmek için satıra çift tıklayın. Toplu işlem için kutucukları işaretleyin (Sil = kalıcı siler, Hurdaya Taşı = hurdada saklar, geri getirilebilir)."
                               Foreground="Gray"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0" />

                    <DataGrid x:Name="ProductGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="False"
                              CanUserAddRows="False"
                              CanUserSortColumns="False"
                              MouseDoubleClick="ProductGrid_MouseDoubleClick" />
                </DockPanel>
            </Grid>

            <!-- GENEL ARAMA SONUÇLARI (ana sayfadaki ve cins sayfasındaki arama kutuları için ortak): sağ-alt köşeden sürüklenerek büyütülebilir.
         Hangi arama kutusunun altında açılacağı kod tarafından belirlenir. -->
            <Popup x:Name="HomeSearchPopup"
                   Placement="Bottom"
                   StaysOpen="True"
                   AllowsTransparency="True">
                <Border x:Name="HomeSearchOverlayBorder"
                        Width="650"
                        Height="420"
                        Background="White"
                        BorderBrush="Gray"
                        BorderThickness="1">
                    <DockPanel>
                        <Thumb x:Name="HomeSearchResizeThumb"
                               DockPanel.Dock="Bottom"
                               HorizontalAlignment="Right"
                               Width="16"
                               Height="16"
                               Cursor="SizeNWSE"
                               Background="Gray"
                               DragDelta="HomeSearchResizeThumb_DragDelta" />
                        <Button DockPanel.Dock="Top"
                                Content="Kapat (X)"
                                HorizontalAlignment="Right"
                                Margin="4"
                                Click="HomeSearchCloseButton_Click" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="HomeSearchGroupsPanel" Margin="8" />
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Popup>

        </Grid>

    </DockPanel>
</Window>
