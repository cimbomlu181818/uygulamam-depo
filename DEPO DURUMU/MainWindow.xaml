<Window x:Class="DEPO_DURUMU.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Depo Durumu"
        Height="600" Width="1000"
        MinHeight="500" MinWidth="800"
        WindowStartupLocation="CenterScreen">

    <DockPanel>

        <!-- ÜST MENÜ (her pencerede görünecek) -->
        <Menu DockPanel.Dock="Top" Padding="4">
            <MenuItem Header="Ana Sayfa" Click="HomeMenu_Click" />
            <MenuItem Header="Ayarlar" Click="SettingsMenu_Click" />
        </Menu>

        <!-- MENÜNÜN ALTINDAKİ ALAN: iki sayfa üst üste durur, biri görünür -->
        <Grid>

            <!-- SAYFA 1: ANA SAYFA -->
            <Grid x:Name="HomePage">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- SOL BÖLÜM: ürün cinsleri -->
                <DockPanel Grid.Column="0" Margin="10">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBox x:Name="HomeSearchBox"
                                 Height="26"
                                 VerticalContentAlignment="Center"
                                 TextChanged="HomeSearchBox_TextChanged"
                                 KeyDown="HomeSearchBox_KeyDown" />
                        <TextBlock x:Name="HomeSearchPlaceholder"
                                   Text="Ara"
                                   Foreground="Gray"
                                   Margin="6,0,0,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False" />
                    </Grid>

                    <TextBlock DockPanel.Dock="Top"
                               Text="Ürün cinsleri "
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Margin="0,0,0,5" />

                    <ListBox x:Name="ProductTypeList"
                             MouseDoubleClick="ProductTypeList_MouseDoubleClick" />
                </DockPanel>

                <!-- ANA SAYFA ARAMA SONUÇLARI: sağ-alt köşeden sürüklenerek büyütülebilir -->
                <Popup x:Name="HomeSearchPopup"
                       PlacementTarget="{Binding ElementName=HomeSearchBox}"
                       Placement="Bottom"
                       StaysOpen="True"
                       AllowsTransparency="True">
                    <Border x:Name="HomeSearchOverlayBorder"
                            Width="650"
                            Height="420"
                            Background="White"
                            BorderBrush="Gray"
                            BorderThickness="1">
                        <DockPanel>
                            <Thumb x:Name="HomeSearchResizeThumb"
                                   DockPanel.Dock="Bottom"
                                   HorizontalAlignment="Right"
                                   Width="16"
                                   Height="16"
                                   Cursor="SizeNWSE"
                                   Background="Gray"
                                   DragDelta="HomeSearchResizeThumb_DragDelta" />
                            <Button DockPanel.Dock="Top"
                                    Content="Kapat (X)"
                                    HorizontalAlignment="Right"
                                    Margin="4"
                                    Click="HomeSearchCloseButton_Click" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="HomeSearchGroupsPanel" Margin="8" />
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Popup>

                <!-- ORTA BÖLÜM: şimdilik boş -->
                <Grid Grid.Column="1" Margin="0,10,10,10" />
            </Grid>

            <!-- SAYFA 2: ÜRÜN CİNSİ SAYFASI -->
            <Grid x:Name="TypePage" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- SOL BÖLÜM: geri dönme, özellik atama, ürün ekleme düğmeleri -->
                <DockPanel Grid.Column="0" Margin="10">
                    <Button DockPanel.Dock="Top"
                            Content="&#x2190; Ana sayfaya dön"
                            Click="BackButton_Click"
                            Height="30"
                            Margin="0,0,0,10" />

                    <Button DockPanel.Dock="Top"
                            Content="Özellik Ata"
                            Click="AssignPropertiesButton_Click"
                            Height="30"
                            Margin="0,0,0,10" />

                    <Button DockPanel.Dock="Top"
                            Content="Yeni Ürün Ekle"
                            Click="AddProductButton_Click"
                            Height="30"
                            Margin="0,0,0,10" />
                </DockPanel>

                <!-- ORTA BÖLÜM: Excel benzeri tablo -->
                <DockPanel Grid.Column="1" Margin="0,10,10,10">
                    <TextBlock x:Name="TypePageTitle"
                               DockPanel.Dock="Top"
                               FontWeight="Bold"
                               FontSize="16"
                               Margin="0,0,0,10" />

                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBox x:Name="TypeSearchBox"
                                 Height="26"
                                 VerticalContentAlignment="Center"
                                 TextChanged="TypeSearchBox_TextChanged" />
                        <TextBlock x:Name="TypeSearchPlaceholder"
                                   Text="Ara"
                                   Foreground="Gray"
                                   Margin="6,0,0,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False" />
                    </Grid>

                    <StackPanel DockPanel.Dock="Top"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,0,0,10">
                        <Button Content="Tümünü Seç/Kaldır"
                                Width="140"
                                Height="30"
                                Margin="0,0,6,0"
                                Click="SelectAllButton_Click" />
                        <Button Content="Seçilenleri Sil"
                                Width="130"
                                Height="30"
                                Click="DeleteSelectedButton_Click" />
                    </StackPanel>

                    <TextBlock DockPanel.Dock="Bottom"
                               Text="Bir ürünün detayını görmek/düzenlemek/silmek için satıra çift tıklayın. Toplu silmek için kutucukları işaretleyin."
                               Foreground="Gray"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0" />

                    <DataGrid x:Name="ProductGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="False"
                              CanUserAddRows="False"
                              CanUserSortColumns="False"
                              MouseDoubleClick="ProductGrid_MouseDoubleClick" />
                </DockPanel>
            </Grid>

        </Grid>

    </DockPanel>
</Window>
