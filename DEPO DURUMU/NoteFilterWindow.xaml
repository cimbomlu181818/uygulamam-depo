<Window x:Class="DEPO_DURUMU.NoteFilterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Filtre"
        Height="420" Width="270"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual">

    <DockPanel Margin="8">

        <!-- ÜST: sıralama ve filtreyi temizleme -->
        <StackPanel DockPanel.Dock="Top">
            <Button Content="A → Z sırala"
                    Height="26"
                    HorizontalContentAlignment="Left"
                    Padding="8,0"
                    Margin="0,0,0,4"
                    Click="SortAscending_Click" />
            <Button Content="Z → A sırala"
                    Height="26"
                    HorizontalContentAlignment="Left"
                    Padding="8,0"
                    Margin="0,0,0,4"
                    Click="SortDescending_Click" />
            <Button x:Name="ClearButton"
                    Content="Filtreyi temizle"
                    Height="26"
                    HorizontalContentAlignment="Left"
                    Padding="8,0"
                    Margin="0,0,0,8"
                    Click="ClearButton_Click" />

            <Grid Margin="0,0,0,6">
                <TextBox x:Name="SearchBox"
                         Height="26"
                         VerticalContentAlignment="Center"
                         TextChanged="SearchBox_TextChanged" />
                <TextBlock x:Name="SearchPlaceholder"
                           Text="Ara"
                           Foreground="Gray"
                           Margin="6,0,0,0"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False" />
            </Grid>

            <CheckBox x:Name="SelectAllBox"
                      Content="(Tümünü Seç)"
                      IsThreeState="True"
                      Margin="2,0,0,4"
                      Click="SelectAllBox_Click" />
        </StackPanel>

        <!-- ALT: Tamam / İptal -->
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,8,0,0">
            <Button x:Name="OkButton"
                    Content="Tamam"
                    Width="80"
                    Height="26"
                    Margin="0,0,6,0"
                    IsDefault="True"
                    Click="OkButton_Click" />
            <Button Content="İptal"
                    Width="80"
                    Height="26"
                    IsCancel="True" />
        </StackPanel>

        <!-- ORTA: değer listesi -->
        <ListBox x:Name="ValuesList"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox Content="{Binding Text}"
                              IsChecked="{Binding IsChecked, Mode=TwoWay}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

    </DockPanel>
</Window>
