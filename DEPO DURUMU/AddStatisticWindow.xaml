<Window x:Class="DEPO_DURUMU.AddStatisticWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="İstatistik Kutusu Ekle"
        Height="220" Width="320"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <StackPanel Margin="15">

        <TextBlock Text="Ürün grubu:" Margin="0,0,0,4" />
        <ComboBox x:Name="TypeCombo"
                  DisplayMemberPath="Name"
                  SelectionChanged="TypeCombo_SelectionChanged"
                  Margin="0,0,0,10" />

        <TextBlock Text="Bilgi:" Margin="0,0,0,4" />
        <ComboBox x:Name="PropertyCombo"
                  DisplayMemberPath="Name"
                  Margin="0,0,0,15" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="İptal" Width="70" Height="28" Margin="0,0,6,0" IsCancel="True" />
            <Button x:Name="AddButton"
                    Content="Ekle"
                    Width="70"
                    Height="28"
                    Click="AddButton_Click"
                    IsDefault="True" />
        </StackPanel>

    </StackPanel>
</Window>
