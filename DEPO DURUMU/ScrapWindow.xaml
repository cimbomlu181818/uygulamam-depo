<Window x:Class="DEPO_DURUMU.ScrapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hurda"
        Height="500" Width="650"
        WindowStartupLocation="CenterOwner">

    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top"
                   Text="Hurda"
                   FontWeight="Bold"
                   FontSize="14"
                   Margin="0,0,0,10" />

        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button x:Name="DeleteButton"
                    Content="Kalıcı Olarak Sil"
                    Width="140"
                    Margin="0,0,6,0"
                    IsEnabled="False"
                    Click="DeleteButton_Click" />
            <Button x:Name="RestoreButton"
                    Content="Geri Getir"
                    Width="100"
                    Margin="0,0,6,0"
                    IsEnabled="False"
                    Click="RestoreButton_Click" />
            <Button Content="Kapat"
                    Width="80"
                    Click="CloseButton_Click" />
        </StackPanel>

        <TextBlock x:Name="EmptyText"
                   DockPanel.Dock="Top"
                   Text="Hurdada hiç ürün yok."
                   Foreground="Gray"
                   Visibility="Collapsed"
                   Margin="0,0,0,10" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- SOL: hurdadaki ürünlerin listesi -->
            <DockPanel Grid.Column="0" Margin="0,0,10,0">
                <TextBlock DockPanel.Dock="Top"
                           Text="Hurdadaki ürünler"
                           Margin="0,0,0,5" />
                <ListBox x:Name="ItemsList"
                         SelectionChanged="ItemsList_SelectionChanged" />
            </DockPanel>

            <!-- SAĞ: seçili ürünün donmuş bilgileri -->
            <DockPanel Grid.Column="1">
                <TextBlock DockPanel.Dock="Top"
                           Text="Detay"
                           Margin="0,0,0,5" />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="DetailsPanel" />
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
