<Window x:Class="DEPO_DURUMU.ScrapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hurda"
        Height="600" Width="1000"
        MinHeight="500" MinWidth="800"
        WindowStartupLocation="CenterOwner">

    <Grid>

        <!-- SAYFA 1: HURDA ANA SAYFASI -->
        <Grid x:Name="HomePage">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- SOL BÖLÜM: hurdadaki ürün cinsleri -->
            <DockPanel Grid.Column="0" Margin="10">
                <TextBlock DockPanel.Dock="Top"
                           Text="Hurdadaki ürün cinsleri (açmak için çift tıklayın)"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           Margin="0,0,0,5" />

                <ListBox x:Name="HomeTypeList"
                         DisplayMemberPath="Display"
                         MouseDoubleClick="HomeTypeList_MouseDoubleClick" />
            </DockPanel>

            <!-- ORTA BÖLÜM -->
            <StackPanel Grid.Column="1" Margin="0,10,10,10">
                <TextBlock Text="Hurda"
                           FontWeight="Bold"
                           FontSize="16"
                           Margin="0,0,0,10" />
                <TextBlock x:Name="HomeInfoText"
                           Foreground="Gray"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <!-- SAYFA 2: HURDADAKİ BİR CİNSİN SAYFASI -->
        <Grid x:Name="TypePage" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- SOL BÖLÜM: iki mod var, biri görünür -->
            <Grid Grid.Column="0">

                <!-- MOD 1: NORMAL BAR (geri, filtrele) -->
                <StackPanel x:Name="NormalLeftPanel" Margin="10">

                    <Button Content="&#x2190; Hurda ana sayfasına dön"
                            Click="BackButton_Click"
                            Height="30"
                            Margin="0,0,0,10" />

                    <Button x:Name="FilterButton"
                            Content="Filtrele"
                            Click="FilterButton_Click"
                            Height="30"
                            Margin="0,0,0,10" />

                </StackPanel>

                <!-- MOD 2: FİLTRE BARI (üstte geri, altında filtre öğeleri) -->
                <DockPanel x:Name="FilterLeftPanel"
                           Margin="10"
                           Visibility="Collapsed">

                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">

                        <Button Content="&#x2190; Geri"
                                Height="30"
                                HorizontalAlignment="Left"
                                Width="80"
                                Margin="0,0,0,10"
                                Click="FilterBackButton_Click" />

                        <DockPanel>
                            <Button DockPanel.Dock="Right"
                                    Content="Temizle"
                                    Width="70"
                                    Click="ClearFiltersButton_Click" />
                            <TextBlock Text="Filtreler"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </DockPanel>

                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="FilterItemsPanel" />
                    </ScrollViewer>

                </DockPanel>

            </Grid>

            <!-- ORTA BÖLÜM: Excel benzeri tablo -->
            <DockPanel Grid.Column="1" Margin="0,10,10,10">

                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <TextBlock x:Name="ProductCountText"
                               DockPanel.Dock="Right"
                               Foreground="Gray"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="TypePageTitle"
                               FontWeight="Bold"
                               FontSize="16" />
                </DockPanel>

                <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                    <TextBox x:Name="TypeSearchBox"
                             Height="26"
                             VerticalContentAlignment="Center"
                             TextChanged="TypeSearchBox_TextChanged" />
                    <TextBlock x:Name="TypeSearchPlaceholder"
                               Text="Ara"
                               Foreground="Gray"
                               Margin="6,0,0,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False" />
                </Grid>

                <StackPanel DockPanel.Dock="Top"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,0,0,10">
                    <Button Content="Tümünü Seç/Kaldır"
                            Width="140"
                            Height="30"
                            Margin="0,0,6,0"
                            Click="SelectAllButton_Click" />
                    <Button Content="Geri Getir"
                            Width="110"
                            Height="30"
                            Margin="0,0,6,0"
                            Click="RestoreSelectedButton_Click" />
                    <Button Content="Kalıcı Olarak Sil"
                            Width="140"
                            Height="30"
                            Click="DeleteSelectedButton_Click" />
                </StackPanel>

                <TextBlock DockPanel.Dock="Bottom"
                           Text="Bir ürünün detayını görmek için satıra çift tıklayın. Toplu işlem için kutucukları işaretleyin (Geri Getir = depoya eski yerine döner, Kalıcı Olarak Sil = geri alınamaz)."
                           Foreground="Gray"
                           TextWrapping="Wrap"
                           Margin="0,6,0,0" />

                <DataGrid x:Name="ProductGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserSortColumns="False"
                          MouseDoubleClick="ProductGrid_MouseDoubleClick" />
            </DockPanel>
        </Grid>

    </Grid>
</Window>
