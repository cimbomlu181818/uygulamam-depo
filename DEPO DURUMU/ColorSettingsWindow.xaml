<Window x:Class="DEPO_DURUMU.ColorSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Renk Ayarları"
        Height="560" Width="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top"
                   TextWrapping="Wrap"
                   Margin="0,0,0,10"
                   Text="Her rengin ne anlama geldiğini buradan yazabilir veya değiştirebilirsin. Anlamı boş bıraktığın renk, tabloda ilk kullanıldığında sana sorulur." />

        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button Content="Kaydet"
                    Width="80"
                    Margin="0,0,6,0"
                    IsDefault="True"
                    Click="SaveButton_Click" />
            <Button Content="Kapat"
                    Width="80"
                    IsCancel="True" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ColorList" />
        </ScrollViewer>
    </DockPanel>
</Window>
