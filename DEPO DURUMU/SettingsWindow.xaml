<Window x:Class="DEPO_DURUMU.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ayarlar"
        Height="450" Width="600"
        WindowStartupLocation="CenterOwner">

    <TabControl Margin="10">

        <!-- SEKME 1: ÜRÜN CİNSLERİ -->
        <TabItem Header="Ürün Cinsleri">
            <DockPanel Margin="10">

                <!-- ÜST: yeni ürün cinsi ekleme -->
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <Button DockPanel.Dock="Right"
                            Content="Ekle"
                            Width="70"
                            Margin="6,0,0,0"
                            Click="AddTypeButton_Click" />
                    <TextBox x:Name="NewTypeNameBox"
                             Height="26"
                             VerticalContentAlignment="Center" />
                </DockPanel>

                <!-- ALT: yeniden adlandır / sil butonları -->
                <StackPanel DockPanel.Dock="Bottom"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,10,0,0">
                    <Button Content="Yeniden Adlandır"
                            Width="120"
                            Margin="0,0,6,0"
                            Click="RenameTypeButton_Click" />
                    <Button Content="Sil"
                            Width="70"
                            Click="DeleteTypeButton_Click" />
                </StackPanel>

                <!-- ORTA: ürün cinsi listesi -->
                <ListBox x:Name="TypeList" DisplayMemberPath="Name" />

            </DockPanel>
        </TabItem>

        <!-- SEKME 2: ÖZELLİKLER -->
        <TabItem Header="Özellikler">
            <DockPanel Margin="10">

                <!-- ÜST: yeni özellik ekleme -->
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <Button DockPanel.Dock="Right"
                            Content="Ekle"
                            Width="70"
                            Margin="6,0,0,0"
                            Click="AddPropertyButton_Click" />
                    <ComboBox x:Name="NewPropertyDataTypeCombo"
                              DockPanel.Dock="Right"
                              Width="90"
                              Margin="6,0,0,0"
                              SelectedIndex="0">
                        <ComboBoxItem Content="Metin" />
                        <ComboBoxItem Content="Sayı" />
                        <ComboBoxItem Content="Tarih" />
                    </ComboBox>
                    <TextBox x:Name="NewPropertyNameBox"
                             Height="26"
                             VerticalContentAlignment="Center" />
                </DockPanel>

                <!-- ALT: yeniden adlandır / sil butonları -->
                <StackPanel DockPanel.Dock="Bottom"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,10,0,0">
                    <Button Content="Yeniden Adlandır"
                            Width="120"
                            Margin="0,0,6,0"
                            Click="RenamePropertyButton_Click" />
                    <Button Content="Sil"
                            Width="70"
                            Click="DeletePropertyButton_Click" />
                </StackPanel>

                <!-- ORTA: özellik listesi -->
                <ListBox x:Name="PropertyList" DisplayMemberPath="Name" />

            </DockPanel>
        </TabItem>

    </TabControl>
</Window>
