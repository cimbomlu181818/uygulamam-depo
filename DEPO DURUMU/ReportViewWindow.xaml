<Window x:Class="DEPO_DURUMU.ReportViewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rapor"
        Height="720" Width="1000"
        MinHeight="400" MinWidth="700"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <DockPanel Margin="10">

        <!-- ALT: DÜĞMELER -->
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button x:Name="SaveButton"
                    Content="Kaydet"
                    Width="90" Height="30"
                    Margin="0,0,20,0"
                    Click="SaveButton_Click" />
            <Button Content="Yazdır"
                    Width="90" Height="30"
                    Margin="0,0,6,0"
                    Click="PrintButton_Click" />
            <Button Content="PDF olarak kaydet"
                    Width="130" Height="30"
                    Margin="0,0,6,0"
                    Click="PdfButton_Click" />
            <Button Content="Excel olarak kaydet"
                    Width="130" Height="30"
                    Margin="0,0,20,0"
                    Click="ExcelButton_Click" />
            <Button Content="Kapat"
                    Width="90" Height="30"
                    IsCancel="True" />
        </StackPanel>

        <!-- ORTA: RAPOR (yazdırılacak belgenin aynısı) -->
        <FlowDocumentScrollViewer x:Name="Viewer"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Auto"
                                  Background="White" />
    </DockPanel>
</Window>
