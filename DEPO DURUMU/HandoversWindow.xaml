<Window x:Class="DEPO_DURUMU.HandoversWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tutanaklar Defteri"
        Height="560" Width="980"
        MinHeight="400" MinWidth="760"
        WindowStartupLocation="CenterOwner">

    <DockPanel Margin="12">

        <!-- ÜST: ARAMA VE KAYIT SAYISI -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock x:Name="CountText"
                       DockPanel.Dock="Right"
                       Foreground="Gray"
                       VerticalAlignment="Center"
                       Margin="10,0,0,0" />
            <Grid>
                <TextBox x:Name="SearchBox"
                         Height="28"
                         VerticalContentAlignment="Center"
                         TextChanged="SearchBox_TextChanged" />
                <TextBlock x:Name="SearchPlaceholder"
                           Text="Ara (tutanak no, birim, tarih, seri no, malzeme)"
                           Foreground="Gray"
                           Margin="6,0,0,0"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False" />
            </Grid>
        </DockPanel>

        <!-- ALT: DÜĞMELER -->
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="Yeni Tutanak"
                    Width="110" Height="30"
                    Margin="0,0,20,0"
                    Click="NewButton_Click" />
            <Button Content="Aç / Düzenle / Yazdır"
                    Width="150" Height="30"
                    Margin="0,0,6,0"
                    Click="OpenButton_Click" />
            <Button Content="Sil"
                    Width="90" Height="30"
                    Margin="0,0,20,0"
                    Click="DeleteButton_Click" />
            <Button Content="Kapat"
                    Width="90" Height="30"
                    IsCancel="True" />
        </StackPanel>

        <!-- ORTA: TUTANAK DEFTERİ (en yeni en üstte) -->
        <DataGrid x:Name="HandoversGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserSortColumns="False"
                  CanUserReorderColumns="False"
                  SelectionMode="Single"
                  HeadersVisibility="Column"
                  GridLinesVisibility="All"
                  MouseDoubleClick="HandoversGrid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="No" Binding="{Binding Id}" Width="55" />
                <DataGridTextColumn Header="Tarih" Binding="{Binding HandoverDate}" Width="90" />
                <DataGridTextColumn Header="Teslim eden" Binding="{Binding FromUnit}" Width="150" />
                <DataGridTextColumn Header="Teslim alan" Binding="{Binding ToUnit}" Width="150" />
                <DataGridTextColumn Header="Kalem" Binding="{Binding ItemCount}" Width="55" />
                <DataGridTextColumn Header="Malzemeler" Binding="{Binding ItemsSummary}" Width="*" />
                <DataGridTextColumn Header="Kayıt zamanı" Binding="{Binding CreatedAtText}" Width="115" />
            </DataGrid.Columns>
        </DataGrid>

    </DockPanel>
</Window>
