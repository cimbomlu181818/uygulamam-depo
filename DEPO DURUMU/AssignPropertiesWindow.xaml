<Window x:Class="DEPO_DURUMU.AssignPropertiesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Özellik Ata"
        Height="400" Width="520"
        WindowStartupLocation="CenterOwner">

    <DockPanel Margin="12">
        <TextBlock x:Name="TitleText"
                   DockPanel.Dock="Top"
                   FontWeight="Bold"
                   FontSize="14"
                   Margin="0,0,0,10" />

        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button Content="Kapat"
                    Width="80"
                    IsCancel="True"
                    Click="CloseButton_Click" />
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- SOL: bu cinse henüz bağlı olmayan özellikler -->
            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top"
                           Text="Bağlı olmayan özellikler"
                           Margin="0,0,0,5" />
                <ListBox x:Name="AvailableList" />
            </DockPanel>

            <!-- ORTA: taşıma okları -->
            <StackPanel Grid.Column="1"
                        VerticalAlignment="Center"
                        Margin="8,0,8,0">
                <Button Content="Ekle &#x2192;"
                        Margin="0,0,0,6"
                        Click="AddButton_Click" />
                <Button Content="&#x2190; Çıkar"
                        Click="RemoveButton_Click" />
            </StackPanel>

            <!-- SAĞ: bu cinse bağlı özellikler -->
            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top"
                           Text="Bu cinse bağlı özellikler"
                           Margin="0,0,0,5" />

                <StackPanel DockPanel.Dock="Bottom"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,6,0,0">
                    <Button Content="&#x2191; Yukarı"
                            Width="80"
                            Margin="0,0,6,0"
                            Click="MoveUpButton_Click" />
                    <Button Content="&#x2193; Aşağı"
                            Width="80"
                            Click="MoveDownButton_Click" />
                </StackPanel>

                <ListBox x:Name="AssignedList" />
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
