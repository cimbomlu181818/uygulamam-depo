<Window x:Class="DEPO_DURUMU.ScrapDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hurda Ürün Detayı"
        Height="480" Width="420"
        WindowStartupLocation="CenterOwner">

    <DockPanel Margin="12">
        <TextBlock x:Name="TitleText"
                   DockPanel.Dock="Top"
                   FontWeight="Bold"
                   FontSize="14"
                   Margin="0,0,0,4" />

        <TextBlock x:Name="SubtitleText"
                   DockPanel.Dock="Top"
                   Foreground="Gray"
                   Margin="0,0,0,10" />

        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button Content="Kalıcı Olarak Sil"
                    Width="130"
                    Margin="0,0,6,0"
                    Click="DeleteButton_Click" />
            <Button Content="Geri Getir"
                    Width="100"
                    Margin="0,0,6,0"
                    Click="RestoreButton_Click" />
            <Button Content="Kapat"
                    Width="80"
                    Click="CloseButton_Click" />
        </StackPanel>

        <!-- Donmuş özellikler buraya, program tarafından otomatik eklenecek -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="FieldsPanel" />
        </ScrollViewer>
    </DockPanel>
</Window>
