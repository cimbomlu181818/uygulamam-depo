<Window x:Class="DEPO_DURUMU.ReportsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Raporlar"
        Height="560" Width="1060"
        MinHeight="400" MinWidth="800"
        WindowStartupLocation="CenterOwner">

    <DockPanel Margin="12">

        <!-- ÜST: YENİ EKLE VE KAYIT SAYISI -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock x:Name="CountText"
                       DockPanel.Dock="Right"
                       Foreground="Gray"
                       VerticalAlignment="Center" />
            <Button Content="Yeni Ekle"
                    Width="110" Height="30"
                    HorizontalAlignment="Left"
                    Click="NewButton_Click" />
        </DockPanel>

        <!-- ALT: KAPAT -->
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="Kapat"
                    Width="90" Height="30"
                    IsCancel="True" />
        </StackPanel>

        <Grid>
            <!-- ORTA: KAYITLI RAPORLAR (en yeni en üstte) -->
            <DataGrid x:Name="ReportsGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserSortColumns="False"
                      CanUserReorderColumns="False"
                      SelectionMode="Single"
                      HeadersVisibility="Column"
                      GridLinesVisibility="All"
                      MouseDoubleClick="ReportsGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Rapor adı" Binding="{Binding Title}" Width="*" />
                    <DataGridTextColumn Header="Tarih aralığı" Binding="{Binding RangeText}" Width="270" />
                    <DataGridTextColumn Header="Kayıt" Binding="{Binding RowCount}" Width="55" />
                    <DataGridTextColumn Header="Hazırlandı" Binding="{Binding CreatedAtText}" Width="115" />
                    <DataGridTemplateColumn Header="İşlemler" Width="290">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Aç" Padding="8,2" Margin="2" Click="OpenRow_Click" />
                                    <Button Content="Yazdır" Padding="8,2" Margin="2" Click="PrintRow_Click" />
                                    <Button Content="PDF" Padding="8,2" Margin="2" Click="PdfRow_Click" />
                                    <Button Content="Excel" Padding="8,2" Margin="2" Click="ExcelRow_Click" />
                                    <Button Content="Sil" Padding="8,2" Margin="2" Click="DeleteRow_Click" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock x:Name="EmptyText"
                       Text="Henüz kayıtlı rapor yok. &quot;Yeni Ekle&quot; ile ilk raporu hazırla."
                       Foreground="Gray"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="Collapsed" />
        </Grid>
    </DockPanel>
</Window>
