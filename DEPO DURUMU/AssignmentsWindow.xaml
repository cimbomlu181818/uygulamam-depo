<Window x:Class="DEPO_DURUMU.AssignmentsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zimmetler Defteri"
        Height="580" Width="1050"
        MinHeight="400" MinWidth="800"
        WindowStartupLocation="CenterOwner">

    <DockPanel Margin="12">

        <!-- ÜST: ARAMA, FİLTRE VE KAYIT SAYISI -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock x:Name="CountText"
                       DockPanel.Dock="Right"
                       Foreground="Gray"
                       VerticalAlignment="Center" />
            <CheckBox x:Name="ShowReturnedCheck"
                      DockPanel.Dock="Right"
                      Content="İade edilenleri de göster"
                      VerticalAlignment="Center"
                      Margin="10,0,15,0"
                      Checked="ShowReturnedCheck_Changed"
                      Unchecked="ShowReturnedCheck_Changed" />
            <Grid>
                <TextBox x:Name="SearchBox"
                         Height="28"
                         VerticalContentAlignment="Center"
                         TextChanged="SearchBox_TextChanged" />
                <TextBlock x:Name="SearchPlaceholder"
                           Text="Ara (kişi, sicil, birim, ürün, seri no, not)"
                           Foreground="Gray"
                           Margin="6,0,0,0"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False" />
            </Grid>
        </DockPanel>

        <!-- ALT: DÜĞMELER -->
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="Düzenle"
                    Width="90" Height="30"
                    Margin="0,0,6,0"
                    Click="EditButton_Click" />
            <Button Content="İade Al"
                    Width="90" Height="30"
                    Margin="0,0,6,0"
                    Click="ReturnButton_Click" />
            <Button Content="Yazdır"
                    Width="90" Height="30"
                    Margin="0,0,6,0"
                    Click="PrintButton_Click" />
            <Button Content="Sil"
                    Width="90" Height="30"
                    Margin="0,0,20,0"
                    Click="DeleteButton_Click" />
            <Button Content="Kapat"
                    Width="90" Height="30"
                    IsCancel="True" />
        </StackPanel>

        <!-- ORTA: ZİMMET DEFTERİ (en yeni en üstte) -->
        <DataGrid x:Name="AssignmentsGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserSortColumns="False"
                  CanUserReorderColumns="False"
                  SelectionMode="Single"
                  HeadersVisibility="Column"
                  GridLinesVisibility="All"
                  MouseDoubleClick="AssignmentsGrid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Durum" Binding="{Binding StatusText}" Width="80" />
                <DataGridTextColumn Header="Ürün tipi" Binding="{Binding TypeName}" Width="100" />
                <DataGridTextColumn Header="Sistem adı" Binding="{Binding SystemNameText}" Width="130" />
                <DataGridTextColumn Header="Seri No" Binding="{Binding SerialNo}" Width="110" />
                <DataGridTextColumn Header="Miktar" Binding="{Binding Quantity}" Width="55" />
                <DataGridTextColumn Header="Kişi" Binding="{Binding PersonName}" Width="130" />
                <DataGridTextColumn Header="Sicil" Binding="{Binding RegistryNo}" Width="80" />
                <DataGridTextColumn Header="Birim" Binding="{Binding Department}" Width="110" />
                <DataGridTextColumn Header="Zimmet tarihi" Binding="{Binding AssignedAtText}" Width="115" />
                <DataGridTextColumn Header="İade tarihi" Binding="{Binding ReturnedAtText}" Width="115" />
                <DataGridTextColumn Header="Not" Binding="{Binding AssignedNote}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

    </DockPanel>
</Window>
