<Window x:Class="DEPO_DURUMU.TypesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ürün Cinsleri"
        Height="450" Width="400"
        WindowStartupLocation="CenterOwner">

    <DockPanel Margin="10">

        <!-- ÜST: yeni ürün cinsi ekleme -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <Button DockPanel.Dock="Right"
                    Content="Ekle"
                    Width="70"
                    Margin="6,0,0,0"
                    Click="AddTypeButton_Click" />
            <TextBox x:Name="NewTypeNameBox"
                     Height="26"
                     VerticalContentAlignment="Center" />
        </DockPanel>

        <!-- ALT: yeniden adlandır / sil / kapat butonları -->
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button Content="Yeniden Adlandır"
                    Width="120"
                    Margin="0,0,6,0"
                    Click="RenameTypeButton_Click" />
            <Button Content="Sil"
                    Width="70"
                    Margin="0,0,6,0"
                    Click="DeleteTypeButton_Click" />
            <Button Content="Kapat"
                    Width="70"
                    Click="CloseButton_Click" />
        </StackPanel>

        <!-- ORTA: ürün cinsi listesi -->
        <ListBox x:Name="TypeList" DisplayMemberPath="Name" />

    </DockPanel>
</Window>
