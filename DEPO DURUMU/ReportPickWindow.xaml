<Window x:Class="DEPO_DURUMU.ReportPickWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Yeni Rapor - İşlem Seçimi"
        Height="520" Width="520"
        MinHeight="400" MinWidth="420"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <DockPanel Margin="14">

        <!-- ÜST: ARALIK VE AÇIKLAMA -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock x:Name="RangeText" FontWeight="SemiBold" />
            <TextBlock Text="Rapora girmesini istediğin işlemlerin yanına tik koy. Parantez içindeki sayı, o işlemin bu aralıktaki kayıt sayısıdır."
                       TextWrapping="Wrap"
                       Foreground="Gray"
                       Margin="0,4,0,0" />
        </StackPanel>

        <!-- ALT: ÖZET VE DÜĞMELER -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="ContinueButton"
                        Content="Devam"
                        Width="90" Height="28"
                        Margin="0,0,6,0"
                        IsDefault="True"
                        IsEnabled="False"
                        Click="ContinueButton_Click" />
                <Button Content="İptal"
                        Width="90" Height="28"
                        IsCancel="True" />
            </StackPanel>
            <TextBlock x:Name="SummaryText"
                       VerticalAlignment="Center"
                       Foreground="Gray" />
        </DockPanel>

        <!-- TÜMÜNÜ SEÇ / TEMİZLE -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
            <Button Content="Tümünü seç" Width="90" Height="24" Margin="0,0,6,0" Click="SelectAllButton_Click" />
            <Button Content="Temizle" Width="80" Height="24" Click="ClearButton_Click" />
        </StackPanel>

        <!-- İŞLEM LİSTESİ (gruplu) -->
        <Grid>
            <ListBox x:Name="OperationsList"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}"
                                           FontWeight="SemiBold"
                                           Margin="2,8,0,2" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListBox.GroupStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Margin="12,3,0,3">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}" />
                                <TextBlock Text="{Binding CountText}" Foreground="Gray" Margin="6,0,0,0" />
                            </StackPanel>
                        </CheckBox>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock x:Name="EmptyText"
                       Text="Bu tarih aralığında hiç işlem yok."
                       Foreground="Gray"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="Collapsed" />
        </Grid>
    </DockPanel>
</Window>
