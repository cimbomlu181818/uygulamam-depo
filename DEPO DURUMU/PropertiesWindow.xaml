<Window x:Class="DEPO_DURUMU.PropertiesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Özellikler"
        Height="540" Width="460"
        WindowStartupLocation="CenterOwner">

    <DockPanel Margin="10">

        <!-- ÜST: yeni özellik ekleme -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <Button DockPanel.Dock="Right"
                    Content="Ekle"
                    Width="70"
                    Margin="6,0,0,0"
                    Click="AddPropertyButton_Click" />
            <ComboBox x:Name="NewPropertyDataTypeCombo"
                      DockPanel.Dock="Right"
                      Width="90"
                      Margin="6,0,0,0"
                      SelectedIndex="0">
                <ComboBoxItem Content="Metin" />
                <ComboBoxItem Content="Sayı" />
                <ComboBoxItem Content="Tarih" />
                <ComboBoxItem Content="Evet/Hayır" />
            </ComboBox>
            <TextBox x:Name="NewPropertyNameBox"
                     Height="26"
                     VerticalContentAlignment="Center" />
        </DockPanel>

        <!-- TOPLU SEÇİM: tümünü işaretle / işaretleri kaldır + kaç tane seçili -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6" LastChildFill="False">
            <Button Content="Tümünü İşaretle"
                    Width="110"
                    Margin="0,0,6,0"
                    Click="SelectAllButton_Click" />
            <Button Content="İşaretleri Kaldır"
                    Width="110"
                    Click="ClearAllButton_Click" />
            <TextBlock x:Name="SelectedCountText"
                       DockPanel.Dock="Right"
                       VerticalAlignment="Center"
                       Foreground="Gray"
                       Text="0 seçili" />
        </DockPanel>

        <!-- ALT: dolu değerleri de sil kutusu + yeniden adlandır / seçilenleri sil / kapat -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <CheckBox x:Name="DeleteValuesCheck"
                      Content="Özelliklerin dolu değerlerini de sil (geri alınamaz)"
                      Foreground="#B00020"
                      Margin="0,0,0,8" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Yeniden Adlandır"
                        Width="120"
                        Margin="0,0,6,0"
                        Click="RenamePropertyButton_Click" />
                <Button Content="Seçilenleri Sil"
                        Width="110"
                        Margin="0,0,6,0"
                        Click="DeleteSelectedButton_Click" />
                <Button Content="Kapat"
                        Width="70"
                        Click="CloseButton_Click" />
            </StackPanel>
        </StackPanel>

        <!-- ORTA: özellik listesi (her satırda işaret kutusu; sabit özelliklerde kutu kapalı) -->
        <ListBox x:Name="PropertyList" HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                  IsEnabled="{Binding CanDelete}"
                                  VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Name}"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Info}"
                                   Margin="8,0,0,0"
                                   Foreground="Gray"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

    </DockPanel>
</Window>
