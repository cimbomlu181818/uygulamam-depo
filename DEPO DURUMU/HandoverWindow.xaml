<Window x:Class="DEPO_DURUMU.HandoverWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Teslim-Tesellüm Tutanağı"
        Height="620" Width="780"
        MinHeight="480" MinWidth="650"
        WindowStartupLocation="CenterOwner">

    <DockPanel Margin="15">

        <!-- ALT: DÜĞMELER -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Yazdır"
                    Width="100" Height="30"
                    Margin="0,0,8,0"
                    Click="PrintButton_Click" />
            <Button Content="Kaydet"
                    Width="100" Height="30"
                    Margin="0,0,8,0"
                    ToolTip="Yazdırmadan sadece defteri günceller (kâğıtta düzeltme yapıldıysa)."
                    Click="SaveButton_Click" />
            <Button Content="Kapat"
                    Width="90" Height="30"
                    IsCancel="True" />
        </StackPanel>

        <!-- ÜST: BİRİM VE TARİH BİLGİLERİ -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">

            <TextBlock Text="DEMİRBAŞ / TÜKETİM MALZEME TESLİM TUTANAĞI"
                       FontSize="14" FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,4" />

            <TextBlock x:Name="RecordText"
                       HorizontalAlignment="Center"
                       Foreground="Gray"
                       Margin="0,0,0,10" />

            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="160" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="Teslim Eden Birim:"
                           VerticalAlignment="Center" FontWeight="SemiBold" />
                <TextBox x:Name="FromUnitBox"
                         Grid.Column="1"
                         Height="26" Margin="6,0,10,0"
                         VerticalContentAlignment="Center" />
                <TextBlock Text="Kategori:"
                           Grid.Column="2"
                           VerticalAlignment="Center" FontWeight="SemiBold" />
                <TextBox x:Name="CategoryBox"
                         Grid.Column="3"
                         Height="26" Margin="6,0,0,0"
                         Text="DEMİRBAŞ"
                         VerticalContentAlignment="Center" />
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="160" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="Teslim Alan Birim:"
                           VerticalAlignment="Center" FontWeight="SemiBold" />
                <TextBox x:Name="ToUnitBox"
                         Grid.Column="1"
                         Height="26" Margin="6,0,10,0"
                         VerticalContentAlignment="Center" />
                <TextBlock Text="Tarih:"
                           Grid.Column="2"
                           VerticalAlignment="Center" FontWeight="SemiBold" />
                <TextBox x:Name="DateBox"
                         Grid.Column="3"
                         Height="26" Margin="6,0,0,0"
                         VerticalContentAlignment="Center" />
            </Grid>

        </StackPanel>

        <!-- ORTA: MALZEME TABLOSU (Excel gibi: son satıra yazınca yeni satır eklenir) -->
        <DataGrid x:Name="ItemsGrid"
                  AutoGenerateColumns="False"
                  CanUserAddRows="True"
                  CanUserDeleteRows="True"
                  CanUserSortColumns="False"
                  CanUserReorderColumns="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="All">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Seri No" Width="140">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding SerialNo}"
                                       VerticalAlignment="Center"
                                       Margin="4,0,0,0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <Grid>
                                <TextBox x:Name="Box"
                                         Text="{Binding SerialNo, UpdateSourceTrigger=PropertyChanged}"
                                         BorderThickness="0"
                                         Loaded="SerialBox_Loaded"
                                         TextChanged="SearchBox_TextChanged" />
                                <Popup x:Name="Popup"
                                       PlacementTarget="{Binding ElementName=Box}"
                                       Placement="Bottom"
                                       StaysOpen="False"
                                       AllowsTransparency="True">
                                    <Border Background="White" BorderBrush="Gray" BorderThickness="1">
                                        <ListBox x:Name="List"
                                                 Width="240" MaxHeight="160"
                                                 DisplayMemberPath="DisplayText"
                                                 PreviewMouseLeftButtonDown="SuggestionsList_PreviewMouseLeftButtonDown" />
                                    </Border>
                                </Popup>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Sistem adı" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ItemType}"
                                       VerticalAlignment="Center"
                                       Margin="4,0,0,0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <Grid>
                                <TextBox x:Name="Box"
                                         Text="{Binding ItemType, UpdateSourceTrigger=PropertyChanged}"
                                         BorderThickness="0"
                                         Loaded="TypeBox_Loaded"
                                         TextChanged="SearchBox_TextChanged" />
                                <Popup x:Name="Popup"
                                       PlacementTarget="{Binding ElementName=Box}"
                                       Placement="Bottom"
                                       StaysOpen="False"
                                       AllowsTransparency="True">
                                    <Border Background="White" BorderBrush="Gray" BorderThickness="1">
                                        <ListBox x:Name="List"
                                                 Width="280" MaxHeight="160"
                                                 DisplayMemberPath="DisplayText"
                                                 PreviewMouseLeftButtonDown="SuggestionsList_PreviewMouseLeftButtonDown" />
                                    </Border>
                                </Popup>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Miktarı"
                                    Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                                    Width="80" />
                <DataGridTextColumn Header="Düşünceler"
                                    Binding="{Binding Note, UpdateSourceTrigger=PropertyChanged}"
                                    Width="180" />
            </DataGrid.Columns>
        </DataGrid>

    </DockPanel>
</Window>
